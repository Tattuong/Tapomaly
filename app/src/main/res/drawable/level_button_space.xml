<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape>
            <gradient
                android:startColor="#2A3254"
                android:endColor="#1A2038"
                android:angle="0" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#4C5C8A" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#5E6EFF"
                android:endColor="#8F48FF"
                android:angle="0" />
            <corners android:radius="22dp" />
            <stroke
                android:width="2dp"
                android:color="#C6D0FF" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:startColor="#6E57C2"
                android:endColor="#7B5FD1"
                android:angle="0" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#B7A6FF" />
        </shape>
    </item>

</selector>