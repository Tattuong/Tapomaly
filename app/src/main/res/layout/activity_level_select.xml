<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/level_select_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="220dp"
        android:paddingBottom="28dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false">

            <Button
                android:id="@+id/btnLevel1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 1"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel2"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 2"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel3"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 3"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel4"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 4"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel5"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 5"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel6"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 6"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel7"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 7"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel8"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 8"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel9"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 9"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/btnLevel10"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="@drawable/level_button_space"
                android:text="Level 10"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@null" />

        </GridLayout>

        <ImageButton
            android:id="@+id/btnBackMenu"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="26dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back to Menu"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/back_to_menu_button" />

    </LinearLayout>

</ScrollView>