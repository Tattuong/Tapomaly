<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="325dp"
        android:paddingBottom="30dp">

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="250dp"
            android:layout_height="62dp"
            android:background="@android:color/transparent"
            android:contentDescription="Play"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/play_button" />

        <ImageButton
            android:id="@+id/btnLevels"
            android:layout_width="250dp"
            android:layout_height="62dp"
            android:layout_marginTop="14dp"
            android:background="@android:color/transparent"
            android:contentDescription="Levels"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/levels_button" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="250dp"
            android:layout_height="62dp"
            android:layout_marginTop="14dp"
            android:background="@android:color/transparent"
            android:contentDescription="Settings"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/settings_button" />

        <ImageButton
            android:id="@+id/btnExit"
            android:layout_width="250dp"
            android:layout_height="62dp"
            android:layout_marginTop="14dp"
            android:background="@android:color/transparent"
            android:contentDescription="Exit"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/exit_button" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="28dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/btnAccount"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Sign in"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMenuCoins"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 coins"
            android:textColor="#FFD166"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnShop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Shop"
            android:textColor="#062033"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>