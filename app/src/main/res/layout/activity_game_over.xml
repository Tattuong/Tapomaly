<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_over_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="240dp"
        android:paddingBottom="30dp">

        <!-- Level and Score Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtGameOverLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level 1"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtGameOverScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Score: 0"
                android:textColor="#FFD166"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Space between score card and buttons -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- Try Again PNG Button -->
        <ImageButton
            android:id="@+id/btnTryAgain"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:contentDescription="Try Again"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/try_again_button" />

        <!-- Main Menu PNG Button -->
        <ImageButton
            android:id="@+id/btnGameOverMenu"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:background="@android:color/transparent"
            android:contentDescription="Main Menu"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/main_menu_button" />

    </LinearLayout>

</FrameLayout>